Import-Module ActiveDirectory

$DomainDN = "DC=corp,DC=deimustech,DC=com"
$RootOU   = "OU=DeimusTech,$DomainDN"
$UsersOU  = "OU=Users,$RootOU"
$EmpOU    = "OU=Employees,$UsersOU"
$AdminOU  = "OU=Admins,$UsersOU"
$SvcOU    = "OU=Service Accounts,$UsersOU"
$CompOU   = "OU=Computers,$RootOU"
$ServerOU = "OU=Servers,$CompOU"
$WksOU    = "OU=Workstations,$CompOU"
$GroupOU  = "OU=Groups,$RootOU"

# ------------------------------------------------------------
# OUs
# ------------------------------------------------------------

$OUs = @(
    @{Name="DeimusTech";       Path=$DomainDN},
    @{Name="Users";            Path=$RootOU},
    @{Name="Employees";        Path=$UsersOU},
    @{Name="Admins";           Path=$UsersOU},
    @{Name="Service Accounts"; Path=$UsersOU},
    @{Name="Computers";        Path=$RootOU},
    @{Name="Servers";          Path=$CompOU},
    @{Name="Workstations";     Path=$CompOU},
    @{Name="Groups";           Path=$RootOU}
)

foreach ($OU in $OUs) {
    $DN = "OU=$($OU.Name),$($OU.Path)"

    if (-not (Get-ADOrganizationalUnit -Identity $DN -ErrorAction SilentlyContinue)) {
        New-ADOrganizationalUnit `
            -Name $OU.Name `
            -Path $OU.Path `
            -ProtectedFromAccidentalDeletion $false
    }
}

# ------------------------------------------------------------
# Security Groups
# ------------------------------------------------------------

$Groups = @(
    @{Name="GG-Shared";      Description="Access to the Shared file share"},
    @{Name="GG-Engineering"; Description="Access to the Engineering file share"},
    @{Name="GG-Projects";    Description="Access to the Projects file share"},
    @{Name="GG-IT";          Description="Access to the IT file share"}
)

foreach ($Group in $Groups) {
    if (-not (Get-ADGroup -Identity $Group.Name -ErrorAction SilentlyContinue)) {
        New-ADGroup `
            -Name $Group.Name `
            -SamAccountName $Group.Name `
            -GroupScope Global `
            -GroupCategory Security `
            -Path $GroupOU `
            -Description $Group.Description
    }
}

# ------------------------------------------------------------
# User Helper
# ------------------------------------------------------------

function Set-DracoUser {
    param(
        [string]$Username,
        [string]$Password,
        [string]$Path,
        [string]$Description
    )

    $SecurePassword = ConvertTo-SecureString $Password -AsPlainText -Force
    $User = Get-ADUser -Identity $Username -ErrorAction SilentlyContinue

    if (-not $User) {
        New-ADUser `
            -Name $Username `
            -SamAccountName $Username `
            -UserPrincipalName "$Username@corp.deimustech.com" `
            -Path $Path `
            -AccountPassword $SecurePassword `
            -Enabled $true `
            -PasswordNeverExpires $true `
            -Description $Description
    }
    else {
        Set-ADAccountPassword `
            -Identity $Username `
            -Reset `
            -NewPassword $SecurePassword

        Set-ADUser `
            -Identity $Username `
            -Enabled $true `
            -PasswordNeverExpires $true `
            -Description $Description

        if ($User.DistinguishedName -notlike "*$Path") {
            Move-ADObject `
                -Identity $User.DistinguishedName `
                -TargetPath $Path
        }
    }
}

