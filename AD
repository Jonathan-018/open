$ErrorActionPreference = "Stop"

Import-Module ActiveDirectory

# ============================================================
# DRACO - DEIMUSTECH ACTIVE DIRECTORY SETUP
# Domain: corp.deimustech.com
# ============================================================

$Domain = Get-ADDomain

if ($Domain.DNSRoot -ne "corp.deimustech.com") {
    throw "Wrong domain. Expected corp.deimustech.com but found $($Domain.DNSRoot)"
}

$DomainDN = $Domain.DistinguishedName

$RootOU   = "OU=DeimusTech,$DomainDN"

$UsersOU  = "OU=Users,$RootOU"
$EmpOU    = "OU=Employees,$UsersOU"
$AdminOU  = "OU=Admins,$UsersOU"
$SvcOU    = "OU=Service Accounts,$UsersOU"

$CompOU   = "OU=Computers,$RootOU"
$ServerOU = "OU=Servers,$CompOU"
$WksOU    = "OU=Workstations,$CompOU"

$GroupOU  = "OU=Groups,$RootOU"


# ============================================================
# OU CREATION
# ============================================================

function New-DracoOU {
    param(
        [string]$Name,
        [string]$Path
    )

    $Existing = Get-ADOrganizationalUnit `
        -LDAPFilter "(ou=$Name)" `
        -SearchBase $Path `
        -SearchScope OneLevel

    if (-not $Existing) {
        New-ADOrganizationalUnit `
            -Name $Name `
            -Path $Path `
            -ProtectedFromAccidentalDeletion $false

        Write-Host "Created OU: $Name"
    }
    else {
        Write-Host "OU exists: $Name"
    }
}


New-DracoOU "DeimusTech" $DomainDN

New-DracoOU "Users" $RootOU
New-DracoOU "Computers" $RootOU
New-DracoOU "Groups" $RootOU

New-DracoOU "Employees" $UsersOU
New-DracoOU "Admins" $UsersOU
New-DracoOU "Service Accounts" $UsersOU

New-DracoOU "Servers" $CompOU
New-DracoOU "Workstations" $CompOU


# ============================================================
# SECURITY GROUPS
# ============================================================

function New-DracoGroup {
    param(
        [string]$Name,
        [string]$Description
    )

    $Existing = Get-ADGroup `
        -Filter "SamAccountName -eq '$Name'"

    if (-not $Existing) {
        New-ADGroup `
            -Name $Name `
            -SamAccountName $Name `
            -GroupScope Global `
            -GroupCategory Security `
            -Path $GroupOU `
            -Description $Description

        Write-Host "Created group: $Name"
    }
    else {
        Set-ADGroup `
            -Identity $Existing `
            -Description $Description

        Write-Host "Group exists: $Name"
    }
}


New-DracoGroup "GG-Shared" `
    "DeimusTech users authorized for the Shared file share"

New-DracoGroup "GG-Engineering" `
    "DeimusTech Engineering users authorized for the Engineering file share"

New-DracoGroup "GG-Projects" `
