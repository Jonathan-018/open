# ------------------------------------------------------------
# Share Group Membership
# ------------------------------------------------------------

$Memberships = @{
    "GG-Shared"      = @("mreyes","rpatel","scooper","appadmin","pkiadmin")
    "GG-Engineering" = @("mreyes","scooper")
    "GG-Projects"    = @("mreyes","rpatel","scooper")
    "GG-IT"          = @("appadmin","pkiadmin")
}

foreach ($Group in $Memberships.Keys) {
    $Existing = @(Get-ADGroupMember $Group | Select-Object -ExpandProperty SamAccountName)

    foreach ($User in $Memberships[$Group]) {
        if ($User -notin $Existing) {
            Add-ADGroupMember -Identity $Group -Members $User
        }
    }
}

