New-DracoGroup "GG-IT" `
    "DeimusTech IT administrators authorized for the IT file share"


# ============================================================
# DOMAIN USER CREATION / UPDATE
# ============================================================

function Set-DracoUser {
    param(
        [string]$Username,
        [string]$Password,
        [string]$OU,
        [string]$Description
    )

    $SecurePassword = ConvertTo-SecureString `
        $Password `
        -AsPlainText `
        -Force

    $User = Get-ADUser `
        -Filter "SamAccountName -eq '$Username'" `
        -Properties DistinguishedName

    if (-not $User) {

        New-ADUser `
            -Name $Username `
            -SamAccountName $Username `
            -UserPrincipalName "$Username@corp.deimustech.com" `
            -Path $OU `
            -AccountPassword $SecurePassword `
            -Enabled $true `
            -PasswordNeverExpires $true `
            -ChangePasswordAtLogon $false `
            -Description $Description

        Write-Host "Created user: $Username"
    }
    else {

        Set-ADAccountPassword `
            -Identity $User `
            -Reset `
            -NewPassword $SecurePassword

        Set-ADUser `
            -Identity $User `
            -UserPrincipalName "$Username@corp.deimustech.com" `
            -Description $Description `
            -PasswordNeverExpires $true `
            -ChangePasswordAtLogon $false

        Enable-ADAccount -Identity $User

        if ($User.DistinguishedName -notlike "*,$OU") {
            Move-ADObject `
                -Identity $User.DistinguishedName `
                -TargetPath $OU

            Write-Host "Moved user to correct OU: $Username"
        }

        Write-Host "Updated user: $Username"
    }
}


