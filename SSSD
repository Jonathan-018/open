sudo dnf install -y realmd sssd sssd-ad sssd-tools adcli oddjob oddjob-mkhomedir samba-common-tools krb5-workstation authselect


sudo realm leave corp.deimustech.com 2>/dev/null || true
sudo systemctl disable --now sssd 2>/dev/null || true
sudo rm -f /etc/sssd/sssd.conf
sudo rm -f /etc/krb5.keytab
sudo rm -rf /var/lib/sss/db/*
sudo rm -rf /var/lib/sss/mc/*
sudo sss_cache -E 2>/dev/null || true

hostname -f
cat /etc/resolv.conf

realm discover corp.deimustech.com

sudo realm join --client-software=sssd --membership-software=adcli --user=Administrator corp.deimustech.com

realm list


sudo tee /etc/sssd/sssd.conf >/dev/null <<'EOF'
[sssd]
services = nss, pam
config_file_version = 2
domains = corp.deimustech.com

[domain/corp.deimustech.com]
id_provider = ad
auth_provider = ad
chpass_provider = ad

ad_domain = corp.deimustech.com
ad_server = dc01.corp.deimustech.com
krb5_realm = CORP.DEIMUSTECH.COM

access_provider = permit
ad_gpo_access_control = permissive

krb5_ccname_template = FILE:/tmp/krb5cc_%U

[pam]
reconnection_retries = 3
EOF

sudo chmod 600 /etc/sssd/sssd.conf
sudo chown root:root /etc/sssd/sssd.conf

sudo authselect select sssd with-mkhomedir --force

sudo systemctl enable --now oddjobd
sudo systemctl enable --now sssd






# To opt out of the system crypto-policies configuration of krb5, remove the
# symlink at /etc/krb5.conf.d/crypto-policies which will not be recreated.
includedir /etc/krb5.conf.d/

[logging]
    default = FILE:/var/log/krb5libs.log
    kdc = FILE:/var/log/krb5kdc.log
    admin_server = FILE:/var/log/kadmind.log

[libdefaults]
    dns_lookup_realm = true
    ticket_lifetime = 7d
    renew_lifetime = 10y
    forwardable = true
    rdns = false
    pkinit_anchors = FILE:/etc/pki/tls/certs/ca-bundle.crt
    spake_preauth_groups = edwards25519
    dns_canonicalize_hostname = fallback
    qualify_shortname = ""
    default_ccache_name = FILE:/tmp/krb5cc_%{uid}
udp_preference_limit = 0
default_realm = CORP.DEIMUSTECH.COM

[realms]
CORP.DEIMUSTECH.COM = {
    kdc = dc01.corp.deimustech.com
    admin_server = dc01.corp.deimustech.com
}

[domain_realm]
.corp.deimustech.com = CORP.DEIMUSTECH.COM
corp.deimustech.com = CORP.DEIMUSTECH.COM














