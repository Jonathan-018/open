sudo bash <<'EOF'
set -e

# Verify the AD groups resolve before changing anything
getent group 'CORP\GG-Shared'
getent group 'CORP\GG-Engineering'
getent group 'CORP\GG-Projects'
getent group 'CORP\GG-IT'

# Create share directories
mkdir -p /srv/shares/{Shared,Engineering,Projects,IT}

# Assign AD groups
chgrp 'CORP\GG-Shared' /srv/shares/Shared
chgrp 'CORP\GG-Engineering' /srv/shares/Engineering
chgrp 'CORP\GG-Projects' /srv/shares/Projects
chgrp 'CORP\GG-IT' /srv/shares/IT

# Group access + SGID inheritance
chmod 2770 /srv/shares/Shared
chmod 2770 /srv/shares/Engineering
chmod 2770 /srv/shares/Projects
chmod 2770 /srv/shares/IT

# Back up working Samba config
cp /etc/samba/smb.conf /etc/samba/smb.conf.before-shares

# Remove only existing definitions for these four shares.
awk '
BEGIN { skip=0 }
{
    if ($0 ~ /^\[(Shared|Engineering|Projects|IT)\]$/) {
        skip=1
        next
    }

    if (skip && $0 ~ /^\[/) {
        skip=0
    }

    if (!skip) print
}
' /etc/samba/smb.conf > /etc/samba/smb.conf.tmp

mv /etc/samba/smb.conf.tmp /etc/samba/smb.conf

# Add the DRACO share definitions
cat >> /etc/samba/smb.conf <<'SMBEOF'

[Shared]
    path = /srv/shares/Shared
    browsable = yes
    read only = no
    valid users = @"CORP\GG-Shared"
    force group = "CORP\GG-Shared"
    create mask = 0660
    directory mask = 2770

[Engineering]
    path = /srv/shares/Engineering
    browsable = yes
    read only = no
    valid users = @"CORP\GG-Engineering"
    force group = "CORP\GG-Engineering"
    create mask = 0660
    directory mask = 2770

[Projects]
    path = /srv/shares/Projects
    browsable = yes
    read only = no
    valid users = @"CORP\GG-Projects"
    force group = "CORP\GG-Projects"
    create mask = 0660
    directory mask = 2770

[IT]
    path = /srv/shares/IT
    browsable = yes
    read only = no
    valid users = @"CORP\GG-IT"
    force group = "CORP\GG-IT"
    create mask = 0660
    directory mask = 2770
SMBEOF

# Validate before restarting Samba
testparm -s

# Restart
systemctl restart smbd winbind

# Verify AD trust still works
net ads testjoin

# Verify final shares
smbclient -L localhost -U Administrator

echo
echo "DRACO shares configured successfully."
echo '\\apps-01\Shared       -> GG-Shared'
echo '\\apps-01\Engineering  -> GG-Engineering'
echo '\\apps-01\Projects     -> GG-Projects'
echo '\\apps-01\IT           -> GG-IT'
EOF
